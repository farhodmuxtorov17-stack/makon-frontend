# MAKON backend muhit o‘zgaruvchilari.
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to‘ldiring.
# `.env` versiya nazoratiga tushmaydi, maxfiy qiymatlar faqat shu yerda turadi.

# --- Ilova -----------------------------------------------------------------
NODE_ENV=development
PORT=4311
# Frontend manzillari, vergul bilan ajratiladi
CORS_ORIGINS=http://localhost:4310
# OpenAPI hujjati yo‘li
SWAGGER_PATH=api/docs

# --- Ma’lumotlar bazasi ----------------------------------------------------
DATABASE_URL=postgresql://makon:makon@localhost:5432/makon?schema=public

# --- Autentifikatsiya ------------------------------------------------------
# Kamida 32 belgidan iborat tasodifiy qiymatlar
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Ro‘yxatdan o‘tish oralig‘idagi qisqa muddatli token
REGISTRATION_TOKEN_TTL=15m

# --- Bir martalik kod ------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Qayta yuborish oralig‘i, sekund
OTP_RESEND_SECONDS=60

# --- Telegram orqali kod yuborish ------------------------------------------
# OTP_SENDER=telegram bo‘lganda quyidagilar majburiy.
# Bo‘sh qoldirilsa, kod jurnalga yoziladi va tashqi xizmat chaqirilmaydi.
OTP_SENDER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Telefon raqamini Telegram chat identifikatoriga aylantiruvchi xizmat manzili
TELEGRAM_RESOLVER_URL=

# --- Didox integratsiyasi --------------------------------------------------
# DIDOX_CLIENT=http bo‘lganda haqiqiy xizmat chaqiriladi,
# DIDOX_CLIENT=memory bo‘lganda mahalliy ishlab chiqish rejimi yoqiladi.
DIDOX_CLIENT=memory
DIDOX_BASE_URL=
DIDOX_API_KEY=
DIDOX_TIN=
DIDOX_TIMEOUT_MS=15000

# --- Fayllarni saqlash -----------------------------------------------------
STORAGE_ROOT=./storage
# Yuklanadigan hujjatning eng katta hajmi, bayt
MAX_UPLOAD_BYTES=20971520
